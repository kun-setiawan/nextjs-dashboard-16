# Copy from .env.local on the Vercel dashboard
# https://nextjs.org/learn/dashboard-app/setting-up-your-database#create-a-postgres-database
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth

# ─── Kilat Storage (CloudKilat S3-compatible) ─────────────────────────────────
# Dapatkan dari panel kontrol CloudKilat: https://www.cloudkilat.com/id/kilat-storage
KILAT_S3_ENDPOINT=
KILAT_S3_ACCESS_KEY=
KILAT_S3_SECRET_KEY=
KILAT_S3_REGION=
KILAT_S3_BUCKET=sdaug